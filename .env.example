# Base URL for the GIS Flood API (Open-Meteo Flood API requires no key by default)
GIS_API_URL=https://flood-api.open-meteo.com/v1/flood

# Optional API key for proprietary GIS services (leave blank for Open-Meteo)
GIS_API_KEY=

# Source name reported in responses
GIS_SOURCE_NAME=Open-Meteo Flood API

# Default test location (Houston, TX - prone to flood events)
TEST_LAT=29.7604
TEST_LON=-95.3698
